# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored — never commit real keys.
#
# ── SECURITY NOTE ────────────────────────────────────────────
# VITE_ prefix means these values ARE bundled into client JS.
# Anyone can read them in the browser devtools.
# Mitigate this by:
#   1. Restricting your Gemini API key to your domain in Google Cloud Console
#      (APIs & Services → Credentials → HTTP referrers)
#   2. Restricting your EmailJS public key to your domain in the EmailJS dashboard
#   3. For production: use a serverless proxy (Netlify Functions, Vercel Functions)
#      so the keys never reach the client at all.
# ─────────────────────────────────────────────────────────────

# ── Google Gemini ─────────────────────────────────────────────
# Get your key: https://aistudio.google.com/app/apikey
VITE_GEMINI_KEY=your_gemini_api_key_here

# ── EmailJS ───────────────────────────────────────────────────
# Setup steps:
#   1. Create a free account at https://www.emailjs.com
#   2. Add Email Service: connect your Gmail account
#      Dashboard → Email Services → Add New Service → Gmail
#      Copy the Service ID shown (e.g. "service_abc123")
#   3. Create Email Template:
#      Dashboard → Email Templates → Create New Template
#      Use these template variables in your template:
#        {{from_name}}   — visitor's name
#        {{from_email}}  — visitor's email (set as Reply-To)
#        {{message}}     — message body
#        {{to_name}}     — always "Iason"
#      Suggested subject: "Portfolio message from {{from_name}}"
#      Copy the Template ID (e.g. "template_xyz789")
#   4. Get your Public Key:
#      Dashboard → Account → General → Public Key
#
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here

# ── Firebase (visit + chat logging) ──────────────────────────
# NOTE: Firebase web config values are NOT secret — they are
# public identifiers. The security is enforced by Firestore
# Security Rules (write-only from public, no reads).
# Get all values from: Firebase Console → Project Settings → Your Apps
#
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
