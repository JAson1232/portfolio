rules_version = '2';

// ── TRON Portfolio — Firestore Security Rules ─────────────────
// Public visitors can INSERT into visits / chat_messages and
// INCREMENT the counters document. Nobody can READ any of it
// via the client SDK — only via the Firebase Console / Admin SDK.

service cloud.firestore {
  match /databases/{database}/documents {

    // One document per page load
    match /visits/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // One document per ARIA message
    match /chat_messages/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // One document per calendar booking
    match /bookings/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // One document per click event
    match /clicks/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Running visitor total — public can increment, never read
    match /counters/{docId} {
      allow create, update: if true;
      allow read, delete: if false;
    }

  }
}
